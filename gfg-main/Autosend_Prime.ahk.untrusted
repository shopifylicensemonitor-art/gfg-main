ResumeLegacyScript() {
    global Running, Paused, EmailIndex, EmailCount, Emails, ResumeIndex
    global StatusText, CounterLabel, ProgressBar, OverlayGui, OverlayLabel, OverlaySub, OverlayBar, overlayX, overlayY
    
    if (Running) {
        return
    }
    if (Emails.Length = 0) {
        return
    }
        
    Running := true
    Paused := false
