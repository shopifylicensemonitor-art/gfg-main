    EmailCount := ResumeIndex - 1
    
    pct := Round((EmailCount / Emails.Length) * 100)
    StatusText.Text := "RESUMING..."
    StatusText.SetFont("c00FF88")
    CounterLabel.Text := EmailCount " / " Emails.Length
    ProgressBar.Value := pct
    ProgressPctLabel.Text := pct "%"
    
    OverlayLabel.Text := EmailCount " of " Emails.Length " sent"
