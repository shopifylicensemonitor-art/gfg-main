; ============================================================
; Gmail Auto-Send v8.7 (Unified Master Dashboard)
; Fixed Inline Token Insertion & Smooth Subject Auto-Numbering
; ============================================================

#Requires AutoHotkey v2.0
#SingleInstance Force
CoordMode "Mouse", "Screen"

global SettingsFile := A_ScriptDir "\gmail_autosend_settings.ini"
global LogFile      := A_ScriptDir "\autosend_log.txt"
global SentLogFile  := A_ScriptDir "\sent_log.csv"
global SubjectsFile := A_ScriptDir "\gmail_subjects.txt"
global EmailsFile   := A_ScriptDir "\gmail_emails.txt"

; --- Delays / Coords ---
global PasteDelay        := 1500
global SubjectDelay      := 1500
global AutoCompleteDelay := 2000
global ConfDelay         := 1500
global SaveDelay         := 1500
global SendDelay         := 2500
global LoopDelay         := 1000
global RandVariation     := 300
global BodyPasteDelay    := 2000
global ComposeX          := 500
global ComposeY          := 300
global ConfX             := 1100
global ConfY             := 706
global SaveX             := 868
global SaveY             := 570
global BodyX             := 700
global BodyY             := 500

; --- Options ---
global ConfidentialMode   := 1
global UseSubjectRotation := 1
global DarkTheme          := 1
global AutoPauseOnFocus   := 0
global UseHtmlBody        := 0
global UseTemplateRotation := 0   ; A/B rotate templates per row
global TemplateRotList     := "1,2" ; which templates to rotate (comma-separated)
global ShowSessionStats    := 1   ; Show stats popup on finish/stop
global SessionStartTime    := 0   ; epoch ms when campaign started
global CampaignMode       := 1   
global CurrentTemplateIdx := 1   

; --- State ---
global Running       := false
global Paused        := false
global PickingTarget := ""
global SubjectIndex  := 1
global Subjects      := []
global Emails        := []
global EmailIndex    := 1
global EmailCount    := 0
global ResumeIndex   := 1
global CurrentZoom   := 100
global LastFocusedEdit := "subject" ; MEMORY TRACKER FOR TOKENS

; --- CSV State ---
global CsvFile       := ""
global CsvHeaders    := []      
global CsvRows       := []      
global CsvRowCount   := 0
global PreviewIndex  := 1       
global ActiveCsvQueue := [] 

; --- UI Globals ---
global MainTabs, MyGui, ToastGui
global StatusText, CounterLabel, ProgressBar, ProgressPctLabel, BtnStart, BtnResume, BtnPause, BtnStop
global ResumeRowEdit
global TestEmailInput, TestRowEdit, TestSendStatusLbl
global CsvModeRadio, LegacyModeRadio, BrowseCsvBtn, CsvFileLabel, CsvLoadedLabel
global CsvVarList, HtmlCodeBox, PreviewBrowser, ZoomLbl, TemplateSelectDD
global FindInput, FindMatchLbl
global FindLastPos := 0, FindLastDir := 1
global ConfModeChk, SubjectRotChk, AutoPauseChk, UseHtmlChk
global ComposeCoordLabel, ConfCoordLabel, SaveCoordLabel, BodyCoordLabel
global PasteDelayEdit, SubjectDelayEdit, AutoCompleteDelayEdit, ConfDelayEdit, SaveDelayEdit, SendDelayEdit, LoopDelayEdit, RandVarEdit, BodyPasteDelayEdit
global EmailBox, ActionDataBtn, SubjectBox, PreviewRecipLbl
