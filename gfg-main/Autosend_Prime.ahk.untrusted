global OverlayGui, OverlayLabel, OverlaySub, OverlayBar
global PreviewTimer := 0

; ============================================================
;  BRAND & THEME
; ============================================================
global BRAND_NAME  := "first_midey"
global BRAND_COLOR := "4A90E2" 

GetTheme(dark) {
    if (dark) {
        return Map("bg", "0D0D1A", "panel", "161628", "card", "1A1A2E", "title", "61DAFB", "accent", "00CFFF", "muted", "9E9E9E", "good", "8BC34A", "edit_bg", "12122A", "edit_fg", "FFFFFF", "btn_bg", "1E1E3A", "btn_fg", "00CFFF", "divider", "252540", "theme_lbl", "☀ Light")
    } else {
        return Map("bg", "F4F6FB", "panel", "E8ECF4", "card", "FFFFFF", "title", "2196F3", "accent", "FF9800", "muted", "757575", "good", "4CAF50", "edit_bg", "FFFFFF", "edit_fg", "111111", "btn_bg", "E0E4EF", "btn_fg", "1565C0", "divider", "D0D4DF", "theme_lbl", "🌙 Dark")
    }
}

; ============================================================
;  Settings Persistence Framework
; ============================================================
LoadSettings() {
    global PasteDelay, SubjectDelay, AutoCompleteDelay, ConfDelay, SaveDelay, SendDelay, LoopDelay, RandVariation, BodyPasteDelay, ComposeX, ComposeY, ConfX, ConfY, SaveX, SaveY, BodyX, BodyY, ConfidentialMode, UseSubjectRotation, DarkTheme, AutoPauseOnFocus, UseHtmlBody, CampaignMode, CurrentTemplateIdx
    if !FileExist(SettingsFile)
        return
    PasteDelay         := Integer(IniRead(SettingsFile, "Delays",  "PasteDelay",        1500))
    SubjectDelay       := Integer(IniRead(SettingsFile, "Delays",  "SubjectDelay",      1500))
    AutoCompleteDelay  := Integer(IniRead(SettingsFile, "Delays",  "AutoCompleteDelay",  2000))
    ConfDelay          := Integer(IniRead(SettingsFile, "Delays",  "ConfDelay",          1500))
    SaveDelay          := Integer(IniRead(SettingsFile, "Delays",  "SaveDelay",          1500))
    SendDelay          := Integer(IniRead(SettingsFile, "Delays",  "SendDelay",          2500))
    LoopDelay          := Integer(IniRead(SettingsFile, "Delays",  "LoopDelay",          1000))
    RandVariation      := Integer(IniRead(SettingsFile, "Delays",  "RandVariation",       300))
    BodyPasteDelay     := Integer(IniRead(SettingsFile, "Delays",  "BodyPasteDelay",     2000))
    ComposeX           := Integer(IniRead(SettingsFile, "Coords",  "ComposeX",            500))
    ComposeY           := Integer(IniRead(SettingsFile, "Coords",  "ComposeY",            300))
    ConfX              := Integer(IniRead(SettingsFile, "Coords",  "ConfX",              1100))
    ConfY              := Integer(IniRead(SettingsFile, "Coords",  "ConfY",               706))
    SaveX              := Integer(IniRead(SettingsFile, "Coords",  "SaveX",               868))
    SaveY              := Integer(IniRead(SettingsFile, "Coords",  "SaveY",               570))
    BodyX              := Integer(IniRead(SettingsFile, "Coords",  "BodyX",               700))
    BodyY              := Integer(IniRead(SettingsFile, "Coords",  "BodyY",               500))
    ConfidentialMode   := Integer(IniRead(SettingsFile, "Options", "ConfidentialMode",      1))
    UseSubjectRotation  := Integer(IniRead(SettingsFile, "Options", "UseSubjectRotation",   1))
    UseTemplateRotation := Integer(IniRead(SettingsFile, "Options", "UseTemplateRotation",  0))
    TemplateRotList     := IniRead(SettingsFile, "Options", "TemplateRotList", "1,2")
    ShowSessionStats    := Integer(IniRead(SettingsFile, "Options", "ShowSessionStats",      1))
    DarkTheme          := Integer(IniRead(SettingsFile, "Options", "DarkTheme",             0))
    AutoPauseOnFocus   := Integer(IniRead(SettingsFile, "Options", "AutoPauseOnFocus",      0))
    UseHtmlBody        := Integer(IniRead(SettingsFile, "Options", "UseHtmlBody",           0))
    CampaignMode       := Integer(IniRead(SettingsFile, "Options", "CampaignMode",          1))
    CurrentTemplateIdx := Integer(IniRead(SettingsFile, "Options", "CurrentTemplateIdx",    1))
}

SaveSettings() {
    global PasteDelay, SubjectDelay, AutoCompleteDelay, ConfDelay, SaveDelay, SendDelay, LoopDelay, RandVariation, BodyPasteDelay, ComposeX, ComposeY, ConfX, ConfY, SaveX, SaveY, BodyX, BodyY, ConfidentialMode, UseSubjectRotation, DarkTheme, AutoPauseOnFocus, UseHtmlBody, CampaignMode, CurrentTemplateIdx
    global UseTemplateRotation, ShowSessionStats, TemplateRotChk, ShowStatsChk, TemplateRotInput, TemplateRotList
    IniWrite PasteDelay,         SettingsFile, "Delays",  "PasteDelay"
    IniWrite SubjectDelay,       SettingsFile, "Delays",  "SubjectDelay"
    IniWrite AutoCompleteDelay,  SettingsFile, "Delays",  "AutoCompleteDelay"
    IniWrite ConfDelay,          SettingsFile, "Delays",  "ConfDelay"
    IniWrite SaveDelay,          SettingsFile, "Delays",  "SaveDelay"
    IniWrite SendDelay,          SettingsFile, "Delays",  "SendDelay"
    IniWrite LoopDelay,          SettingsFile, "Delays",  "LoopDelay"
    IniWrite RandVariation,      SettingsFile, "Delays",  "RandVariation"
    IniWrite BodyPasteDelay,     SettingsFile, "Delays",  "BodyPasteDelay"
    IniWrite ComposeX,           SettingsFile, "Coords",  "ComposeX"
    IniWrite ComposeY,           SettingsFile, "Coords",  "ComposeY"
    IniWrite ConfX,              SettingsFile, "Coords",  "ConfX"
    IniWrite ConfY,              SettingsFile, "Coords",  "ConfY"
    IniWrite SaveX,              SettingsFile, "Coords",  "SaveX"
    IniWrite SaveY,              SettingsFile, "Coords",  "SaveY"
    IniWrite BodyX,              SettingsFile, "Coords",  "BodyX"
    IniWrite BodyY,              SettingsFile, "Coords",  "BodyY"
    IniWrite ConfidentialMode,   SettingsFile, "Options", "ConfidentialMode"
    IniWrite UseSubjectRotation,  SettingsFile, "Options", "UseSubjectRotation"
    IniWrite UseTemplateRotation, SettingsFile, "Options", "UseTemplateRotation"
    IniWrite TemplateRotList,     SettingsFile, "Options", "TemplateRotList"
    IniWrite ShowSessionStats,    SettingsFile, "Options", "ShowSessionStats"
    IniWrite DarkTheme,          SettingsFile, "Options", "DarkTheme"
    IniWrite AutoPauseOnFocus,   SettingsFile, "Options", "AutoPauseOnFocus"
    IniWrite UseHtmlBody,        SettingsFile, "Options", "UseHtmlBody"
    IniWrite CampaignMode,       SettingsFile, "Options", "CampaignMode"
    IniWrite CurrentTemplateIdx, SettingsFile, "Options", "CurrentTemplateIdx"
}

LoadSubjects() {
    global Subjects
    Subjects := []
    if FileExist(SubjectsFile) {
        loop read SubjectsFile {
            cleanLine := RegExMatch(A_LoopReadLine, "^\d+\.\s*(.+)", &m) ? m[1] : A_LoopReadLine
            if (Trim(cleanLine) != "")
                Subjects.Push(Trim(cleanLine))
        }
    }
}

LoadEmails() {
    global Emails
    Emails := []
    if FileExist(EmailsFile) {
        loop read EmailsFile
            if (Trim(A_LoopReadLine) != "")
                Emails.Push(Trim(A_LoopReadLine))
    }
}

LoadHTMLTemplate(idx) {
    try {
        rawString := IniRead(SettingsFile, "HTML_Template_" idx, "Code")
        return StrReplace(rawString, "<ahk_br>", "`n")
    } catch {
        return "<h3>Template " idx " Empty</h3>`n<p>Paste your HTML email setup here.</p>"
    }
}

SaveHTMLTemplate(idx, code) {
    escapedCode := StrReplace(code, "`n", "<ahk_br>")
    escapedCode := StrReplace(escapedCode, "`r", "")
    IniWrite(escapedCode, SettingsFile, "HTML_Template_" idx, "Code")
}

